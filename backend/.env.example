# Required on the backend and in the local developer environment; never VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-side-secret-key
# Local development: automatically fetch and save missing captions.
# On Vercel use APP_ENV=production and TRANSCRIPT_SOURCE=supabase.
# Production/Vercel enforce cache-only behavior even if auto is configured.
APP_ENV=development
TRANSCRIPT_SOURCE=auto
# HTTPS read/write inactivity timeout; positive seconds, maximum 30. No retries.
SUPABASE_TIMEOUT_SECONDS=10

# Comma-separated exact frontend origins. Never use * in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LOCAL EXTRACTION ONLY (automatic processing and optional CLI).
# Caption track priority. Original captions only; never automatically translated.
YOUTUBE_CAPTION_LANGUAGES=en
# If preferred languages are absent, allow another original caption language.
YOUTUBE_CAPTION_FALLBACK=true
# Positive seconds, maximum 120 each. Six sends maximum; no retries.
YOUTUBE_CONNECT_TIMEOUT_SECONDS=3
YOUTUBE_READ_TIMEOUT_SECONDS=10
YOUTUBE_REQUEST_BUDGET_SECONDS=30

# Real RAG: backend keys only. Never put these in React or commit real values.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
# Existing tubechunks index embeds this field with Pinecone's hosted Llama model.
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2
PINECONE_EMBEDDING_FIELD=chunk_text
PINECONE_EMBEDDING_DIMENSIONS=1024
PINECONE_API_KEY=
PINECONE_INDEX_NAME=tubechunks
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=180
RAG_EMBED_BATCH_SIZE=32
RAG_TOP_K=4
RAG_MIN_SCORE=0.25
# Per-provider socket timeout; OpenAI chat retries once, Pinecone never retries.
RAG_API_TIMEOUT_SECONDS=10
# Local indexing checks the overall budget between bounded batches/requests.
RAG_INDEX_TIMEOUT_SECONDS=90
RAG_MAX_CHUNKS=2000

# Optional restricted LangSmith traces: prompts, answers, history and sources hidden.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tubeInsight-ai
CHAT_HISTORY_MESSAGES=12
CHAT_HISTORY_CHARS=12000
AGENT_MAX_TOOL_CALLS=3
AGENT_MAX_MODEL_CALLS=6
AGENT_REQUEST_BUDGET_SECONDS=45
TRANSCRIPT_MAX_WINDOW_SECONDS=600
TRANSCRIPT_POINT_WINDOW_SECONDS=30
TOOL_MAX_TEXT_CHARS=14000
SUMMARY_BATCH_CHARS=8000
SUMMARY_MAX_BATCHES=3

# Day 4: original-language file transcription; no translation or audio storage.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Decimal MB, 0.01–4. Whole multipart body gets at most 64 KB extra overhead.
MAX_AUDIO_UPLOAD_MB=4
# Provider timeout 1–30 seconds; no retries. Upload reception has a 15s deadline.
AUDIO_TIMEOUT_SECONDS=20
# Live evaluation requires BOTH this switch and --mode live --enable-live.
EVALUATION_ENABLE_LIVE=false
EVALUATION_OUTPUT_DIR=reports/evaluation
